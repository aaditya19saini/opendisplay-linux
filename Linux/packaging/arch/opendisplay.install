post_install() {
  cat <<'MSG'
==> OpenDisplay sessions are run by a user service. Enable it with:
      systemctl --user enable --now opendisplayd.service
    Then use `opendisplayctl extend|mirror|status`, opendisplay-gui, or the
    Omarchy bar plugin in /usr/share/opendisplay/integrations/omarchy/.
==> On Hyprland, add this line to ~/.config/hypr/hyprland.lua so config
    reloads keep the virtual monitor's mode:
      pcall(dofile, (os.getenv("XDG_STATE_HOME") or (os.getenv("HOME") .. "/.local/state")) .. "/opendisplay/hyprland.lua")
MSG
}

post_upgrade() {
  post_install
  echo "==> Restart the service to load the new version: systemctl --user restart opendisplayd"
}
